# 本檔只放變數名稱，值請留空。
# 不要把真實金鑰寫進這個檔，也不要提交 .env。
# 實際使用時請複製為 .env（已被 .gitignore 排除），再自行填入。

# 必要：Massive 股價 API，用來抓個股拆股調整日線
MASSIVE_API_KEY=

# 可選：若不以環境變數提供金鑰，改指向本機權限 0600 的金鑰檔
# MASSIVE_KEY_PATH=

# 若要推送到 GitHub Pages，向使用者索取後再填入；不可寫進 repo
GITHUB_TOKEN=

# 目前 FRED 使用公開 CSV，不需要金鑰。若改用 FRED API，先問使用者再取消註解
# FRED_API_KEY=
